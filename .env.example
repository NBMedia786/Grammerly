# Copy this file to .env and fill in real values. .env is gitignored — never commit secrets.

# --- Vertex AI / Gemini (existing) ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_APPLICATION_CREDENTIALS=credentials/your-service-account.json

# --- Copyleaks AI Detector (optional) ---
# When BOTH are set, the Originality button uses Copyleaks for AI detection (accurate).
# When unset or on any error, it falls back to the free Gemini heuristic automatically.
# Get these from https://copyleaks.com/ -> account -> API access.
COPYLEAKS_EMAIL=
COPYLEAKS_API_KEY=
# Optional: set to 1 to test the wiring without spending credits (returns sandbox results).
COPYLEAKS_SANDBOX=
